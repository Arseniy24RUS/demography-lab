# Optional Vite development configuration. For the prebuilt release use public/workshop-config.json.
# Only a public publishable/anon key belongs in VITE_* variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_WORKSHOP_REALTIME=true
# Questionnaire must use a different origin. Examples for local two-server verification:
# VITE_WORKSHOP_SURVEY_URL=http://127.0.0.1:4174/survey.html
# VITE_WORKSHOP_CLASSROOM_ORIGIN=http://127.0.0.1:4173
VITE_WORKSHOP_SURVEY_URL=
VITE_WORKSHOP_CLASSROOM_ORIGIN=

# Administrative Node processes only. Keep actual values outside source and release archives.
# SUPABASE_DB_URL is a PostgreSQL connection string, never a browser variable.
SUPABASE_DB_URL=
DW_FACILITATOR_EMAIL=
