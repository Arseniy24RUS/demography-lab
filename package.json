{
  "name": "demography-workshop",
  "version": "0.8.2",
  "private": true,
  "description": "Демографическая мастерская — документы, практики, барьеры и совместное проектирование",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test",
    "serve:release": "node scripts/serve.mjs",
    "test:database": "node --test --test-concurrency=1 tests/database/*.test.mjs",
    "test:collaboration": "node --test --test-concurrency=1 tests/collaboration/*.integration.test.mjs",
    "test:e2e:collaboration": "playwright test --config playwright.stage-two.config.ts",
    "test:e2e:workshop": "playwright test --config playwright.stage-three.config.ts",
    "prepare:map": "node scripts/prepare-region-map.mjs",
    "test:e2e:barriers": "playwright test --config playwright.stage-four.config.ts",
    "check:survey-bundle": "node scripts/check-survey-bundle.mjs",
    "test:e2e:roadmaps": "playwright test --config playwright.stage-five.config.ts",
    "seed:roadmaps:check": "node scripts/seed-roadmaps.mjs --check",
    "test:e2e:statistics": "playwright test --config playwright.stage-six.config.ts",
    "offline:prepare": "node scripts/offline/server.mjs --prepare",
    "offline:start": "node scripts/offline/server.mjs",
    "offline:backup": "node scripts/offline/server.mjs --backup",
    "offline:originals": "node scripts/cache-originals.mjs",
    "test:offline": "node --test --test-concurrency=1 tests/offline/*.test.mjs",
    "test:macos": "node --test tests/macos/*.test.mjs",
    "test:e2e:offline": "node tests/offline/browser.e2e.mjs"
  },
  "keywords": [],
  "author": "Арсений Михайлович Ситковский",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@noble/hashes": "2.4.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@supabase/supabase-js": "2.119.0",
    "docx": "9.15.3",
    "fflate": "0.8.3",
    "lucide-react": "1.70.0",
    "pdf-lib": "1.17.1",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "d3-geo": "3.1.2",
    "fake-indexeddb": "6.2.7",
    "jsdom": "31.0.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "supabase": "3.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
